{
  "info": {
    "name": "Changelog & Product Updates Widget API",
    "description": "Auth (JWT cookies), public changelog, admin CRUD, reactions, notifications, uploads.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "Admin@12345" },
    { "key": "userEmail", "value": "alice@example.com" },
    { "key": "userPassword", "value": "User@12345" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"Password123\"\n}" },
            "url": "{{baseUrl}}/auth/signup"
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"<raw-token-from-dev-response>\"\n}" },
            "url": "{{baseUrl}}/auth/verify-email"
          }
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        { "name": "Refresh", "request": { "method": "POST", "url": "{{baseUrl}}/auth/refresh" } },
        { "name": "Logout", "request": { "method": "POST", "url": "{{baseUrl}}/auth/logout" } },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\"\n}" },
            "url": "{{baseUrl}}/auth/forgot-password"
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"<raw-token>\",\n  \"password\": \"NewPass123\"\n}" },
            "url": "{{baseUrl}}/auth/reset-password"
          }
        },
        { "name": "Me", "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" } }
      ]
    },
    {
      "name": "Public Changelog",
      "item": [
        { "name": "List Published", "request": { "method": "GET", "url": "{{baseUrl}}/changelog?page=1&limit=10" } },
        { "name": "Filter by Category", "request": { "method": "GET", "url": "{{baseUrl}}/changelog?category=New" } },
        { "name": "Search", "request": { "method": "GET", "url": "{{baseUrl}}/changelog/search?q=dark" } },
        { "name": "Public JSON Feed", "request": { "method": "GET", "url": "{{baseUrl}}/changelog/feed" } },
        { "name": "Get by Slug", "request": { "method": "GET", "url": "{{baseUrl}}/changelog/introducing-dark-mode" } }
      ]
    },
    {
      "name": "Reactions",
      "item": [
        {
          "name": "React to Changelog",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"heart\"\n}" },
            "url": "{{baseUrl}}/changelog/<changelogId>/reactions"
          }
        },
        { "name": "Remove Reaction", "request": { "method": "DELETE", "url": "{{baseUrl}}/changelog/<changelogId>/reactions/heart" } }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        { "name": "List Notifications", "request": { "method": "GET", "url": "{{baseUrl}}/notifications" } },
        { "name": "Unread Count", "request": { "method": "GET", "url": "{{baseUrl}}/notifications/unread-count" } },
        { "name": "Mark as Read", "request": { "method": "POST", "url": "{{baseUrl}}/notifications/mark-read" } }
      ]
    },
    {
      "name": "Admin - Changelogs",
      "item": [
        { "name": "List All (Admin)", "request": { "method": "GET", "url": "{{baseUrl}}/admin/changelogs" } },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"New Feature\",\n  \"category\": \"New\",\n  \"status\": \"Draft\",\n  \"contentMarkdown\": \"# New Feature\\n\\nDetails here.\"\n}" },
            "url": "{{baseUrl}}/admin/changelogs"
          }
        },
        { "name": "Get One", "request": { "method": "GET", "url": "{{baseUrl}}/admin/changelogs/<id>" } },
        {
          "name": "Update",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated Title\"\n}" },
            "url": "{{baseUrl}}/admin/changelogs/<id>"
          }
        },
        { "name": "Delete", "request": { "method": "DELETE", "url": "{{baseUrl}}/admin/changelogs/<id>" } },
        { "name": "Publish", "request": { "method": "PATCH", "url": "{{baseUrl}}/admin/changelogs/<id>/publish" } },
        { "name": "Unpublish", "request": { "method": "PATCH", "url": "{{baseUrl}}/admin/changelogs/<id>/unpublish" } }
      ]
    },
    {
      "name": "Uploads",
      "item": [
        {
          "name": "Upload Cover Image",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [{ "key": "image", "type": "file", "src": "" }] },
            "url": "{{baseUrl}}/uploads"
          }
        }
      ]
    }
  ]
}
